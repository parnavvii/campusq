# ---- Server ----
PORT=5000
NODE_ENV=development
# Origin(s) of the React app allowed by CORS and Socket.IO (comma-separated)
CLIENT_ORIGIN=http://localhost:5173

# ---- MySQL ----
DB_HOST=localhost
DB_PORT=3306
DB_USER=campusq
DB_PASSWORD=campusq_pass
DB_NAME=campusq

# ---- Auth ----
# Use a long random string. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_EXPIRES_IN=8h
BCRYPT_ROUNDS=10

# ---- Deployment ----
# Number of proxies in front of the app (1 on Render/Railway/behind Nginx), so
# rate limits see each customer's real IP. Leave empty when running locally.
TRUST_PROXY=
